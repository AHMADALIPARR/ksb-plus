/ Layer 14 tests. Run via run-tests.sh, which feeds the layer chain
/ src/l00.k through src/l14.k, then this file to Kona. Each chk
/ prints PASS name or FAIL name. The last line prints ALL PASS
/ only when every check passed. The counter uses indexed assignment
/ on a global 1-element list (see kona-notes: plain assignment
/ inside chk reads an uninitialized local). Single-element lists
/ must be enlisted with ,(...) -- a bare atom is not a vector.
/ File paths are symbols; Kona appends .K only when absent, and
/ these names already end in .K. Test files are git-ignored.
/ OHLC rows follow first occurrence order of (sym,bucket) pairs
/ (Kona ? preserves order); ohlc-unsorted expects (a,20) before (a,0).
FC:(,0)
chk:{[n;g;w] m:g~w; FC[0]:FC[0]+(~m); (:[m; "PASS "; "FAIL "]),n}
tabA0:yAcctNew[100 200 300;1000 2000 3000][1]
tabA1:yTransfer[tabA0;100;200;250][1]
tabA2:yTransfer[tabA1;200;300;1000][1]
tabO:yAcctNew[1 2;100,kIMAX][1]
tabBig:yAcctNew[,1;,kIMAX][1]
chk["acct-new"; yAcctNew[100 200 300;1000 2000 3000]; (1;tabA0)]
chk["acct-new-empty"; yAcctNew[!0;!0]; (1;oTable[`acct`bal;(!0;!0)][1])]
chk["acct-new-badtype"; yAcctNew[`a`b;1000 2000]; (0;"type")]
chk["acct-new-length"; yAcctNew[100 200;,1000]; (0;"shape")]
chk["acct-new-dup"; yAcctNew[100 100;1000 2000]; (0;"key")]
chk["acct-new-neg"; yAcctNew[,100;,-5]; (0;"range")]
chk["bal-hit"; yBal[tabA0;200]; (1;2000)]
chk["bal-miss"; yBal[tabA0;999]; (0;"key")]
chk["bal-badtype"; yBal[tabA0;`x]; (0;"type")]
chk["deposit"; yDeposit[tabA0;100;500]; (1;oTable[`acct`bal;(100 200 300;1500 2000 3000)][1])]
chk["deposit-unknown"; yDeposit[tabA0;999;500]; (0;"key")]
chk["deposit-neg"; yDeposit[tabA0;100;-1]; (0;"range")]
chk["deposit-overflow"; yDeposit[tabBig;1;1]; (0;"overflow")]
chk["withdraw"; yWithdraw[tabA0;200;500]; (1;oTable[`acct`bal;(100 200 300;1000 1500 3000)][1])]
chk["withdraw-exact"; yWithdraw[tabA0;100;1000]; (1;oTable[`acct`bal;(100 200 300;0 2000 3000)][1])]
chk["withdraw-funds"; yWithdraw[tabA0;100;1001]; (0;"funds")]
chk["withdraw-neg"; yWithdraw[tabA0;100;-1]; (0;"range")]
chk["transfer"; yTransfer[tabA0;100;200;250]; (1;tabA1)]
chk["transfer-conserved"; yConserved[tabA0;tabA1]; (1;1)]
chk["transfer-notconserved"; yConserved[tabA0;yDeposit[tabA0;100;1][1]]; (1;0)]
chk["transfer-unknown-from"; yTransfer[tabA0;999;200;10]; (0;"key")]
chk["transfer-unknown-to"; yTransfer[tabA0;100;999;10]; (0;"key")]
chk["transfer-self"; yTransfer[tabA0;100;100;10]; (0;"shape")]
chk["transfer-neg"; yTransfer[tabA0;100;200;-1]; (0;"range")]
chk["transfer-funds"; yTransfer[tabA0;100;200;1001]; (0;"funds")]
chk["transfer-overflow"; yTransfer[tabO;1;2;50]; (0;"overflow")]
chk["total"; yTotal[tabA0]; (1;6000)]
chk["total-empty"; yTotal[yAcctNew[!0;!0][1]]; (1;0)]
j0:yJNew[1]
j1:yJAppend[j0;0;100;200;250][1]
j2:yJAppend[j1;1;200;300;1000][1]
j3:yJAppend[j1;1;200;300;999][1]
jbad:yJAppend[j0;0;999;200;250][1]
chk["j-new"; yJNew; (1;oTable[`jid`from`to`amt;(!0;!0;!0;!0)][1])]
chk["j-append"; yJAppend[j0;0;100;200;250]; (1;j1)]
chk["j-append-badtype"; yJAppend[j0;0;100;200;`x]; (0;"type")]
chk["j-append-neg"; yJAppend[j0;0;100;200;-1]; (0;"range")]
chk["j-append-badtab"; yJAppend[tabA0;0;100;200;250]; (0;"shape")]
chk["j-replay"; yJReplay[j2;tabA0]; (1;tabA2)]
chk["j-check-pass"; yJCheck[j2;tabA0;tabA2]; (1;1)]
chk["j-check-tamper"; yJCheck[j3;tabA0;tabA2]; (1;0)]
chk["j-check-unknown"; yJCheck[jbad;tabA0;tabA2]; (0;"key")]
spA:qSplitTable[tabA0]
wrA:qWrite[sNew;spA[1]]
st0:wrA[1][0]
mn0:wrA[1][1]
tr:yTxTransfer[st0;mn0;0;wNew;7;100;200;250]
st1:tr[1][0]
mn1:tr[1][1]
wal1:tr[1][3]
chk["store-write-read"; qRead[st0;mn0]; (1;tabA0)]
chk["tx-ver"; tr[1][2]; 1]
chk["tx-bal"; qRead[st1;mn1]; (1;tabA1)]
chk["tx-walcount"; #wal1[1]; 3]
chk["tx-marker"; wal1[1][2][1]; `commit]
chk["tx-replay"; qRead[tReplay[st0;wal1][1];mn1]; (1;tabA1)]
b1:yTxBuild[st0;mn0;0;11;100;200;100]
b2:yTxBuild[st0;mn0;0;12;100;300;100]
c1:tCommit[b1[1][0];st0;0;wNew]
chk["tx-build-valid"; tIsTxn[b1[1][0]]; 1]
chk["tx-commit1-ver"; c1[1][2]; 1]
chk["tx-conflict"; tCommit[b2[1][0];c1[1][1];1;wNew]; (0;"conflict")]
b3:yTxBuild[c1[1][1];b1[1][1];1;13;100;300;100]
c3:tCommit[b3[1][0];c1[1][1];1;c1[1][3]]
chk["tx-retry-ver"; c3[1][2]; 2]
chk["tx-retry-bal"; qRead[c3[1][1];b3[1][1]]; (1;yAcctNew[100 200 300;800 2100 3100][1])]
b4:yTxBuild[st0;mn0;0;14;200;300;500]
ab:tAbort[b4[1][0];wNew]
walA:ab[1][1]
chk["tx-abort-wal"; (walA[1][0][1];#walA[1]); (`abort;1)]
chk["tx-abort-replay"; qRead[tReplay[st0;walA][1];mn0]; (1;tabA0)]
envA:(,(`a;tabA0))
chk["sql-accts"; zSQL[envA;"select acct, bal from a where bal >= 2000 order by acct"]; (1;oTable[`acct`bal;(200 300;2000 3000)][1])]
chk["sql-accts-sum"; zSQL[envA;"select sum(bal) from a"]; (1;oTable[(,`sum);(,(,6000))][1])]
chk["q-accts-exec"; uQ[envA;"exec bal from a where acct = 200"]; (1;,2000)]
tk:yTickNew[0 10 20 30;`a`a`a`b;10.0 12.0 11.0 20.0;100 200 150 50][1]
tkU:yTickNew[20 0 10;`a`a`a;11.0 10.0 12.0;150 100 200][1]
tkE:yTickNew[!0;0#`a;0#1.0 2.0;!0][1]
ohl1:oTable[`sym`bucket`open`high`low`close`vol;(`a`a`b;0 20 20;10.0 11.0 20.0;12.0 11.0 20.0;10.0 11.0 20.0;12.0 11.0 20.0;300 150 50)][1]
ohlU:oTable[`sym`bucket`open`high`low`close`vol;(`a`a;20 0;11.0 10.0;11.0 12.0;11.0 10.0;11.0 12.0;150 300)][1]
ohlE:oTable[`sym`bucket`open`high`low`close`vol;((0#`a);!0;(0#1.0 2.0);(0#1.0 2.0);(0#1.0 2.0);(0#1.0 2.0);!0)][1]
chk["tick-new"; yTickNew[0 10 20 30;`a`a`a`b;10.0 12.0 11.0 20.0;100 200 150 50]; (1;tk)]
chk["tick-badlen"; yTickNew[0 10;`a`b`c;10.0 12.0;100 200]; (0;"shape")]
chk["tick-negvol"; yTickNew[,0;,`a;,10.0;,-1]; (0;"range")]
chk["tick-negts"; yTickNew[,-1;,`a;,10.0;,100]; (0;"range")]
chk["tick-nan"; yTickNew[,0;,`a;,(0.0%0.0);,100]; (0;"valid")]
chk["tick-badtype"; yTickNew[,0;,`a;,10;,100]; (0;"type")]
chk["ohlc"; yOHLC[tk;20]; (1;ohl1)]
chk["ohlc-unsorted"; yOHLC[tkU;20]; (1;ohlU)]
chk["ohlc-single"; yOHLC[yTickNew[,5;,`z;,7.5;,9][1];10]; (1;oTable[`sym`bucket`open`high`low`close`vol;((,`z);(,0);(,7.5);(,7.5);(,7.5);(,7.5);(,9))][1])]
chk["ohlc-empty"; yOHLC[tkE;10]; (1;ohlE)]
chk["ohlc-badwidth"; yOHLC[tk;0]; (0;"range")]
chk["vwap"; yVwap[tk]; (1;12.1)]
chk["vwap-simple"; yVwap[yTickNew[0 1;`a`a;10.0 20.0;3 1][1]]; (1;12.5)]
chk["vwap-zerovol"; yVwap[yTickNew[,0;,`a;,10.0;,0][1]]; (0;"range")]
chk["vwap-empty"; yVwap[tkE]; (0;"empty")]
chk["roll-n2"; yRollMean[1.0 2.0 3.0 4.0;2]; (1;1.0 1.5 2.5 3.5)]
chk["roll-n1"; yRollMean[1.0 2.0 3.0;1]; (1;1.0 2.0 3.0)]
chk["roll-nbig"; yRollMean[1.0 2.0;5]; (1;1.0 1.5)]
chk["roll-badn"; yRollMean[1.0 2.0;0]; (0;"range")]
chk["roll-badtype"; yRollMean[1 2 3;2]; (0;"type")]
chk["roll-empty"; yRollMean[0#1.0 2.0;2]; (1;0#1.0 2.0)]
chk["persist-save-store"; sSave[st1;`y14store.K]; (1;`y14store.K)]
chk["persist-save-wal"; wSave[wal1;`y14wal.K]; (1;`y14wal.K)]
chk["persist-save-store0"; sSave[st0;`y14store0.K]; (1;`y14store0.K)]
ldS:sLoad[`y14store.K]
ldW:wLoad[`y14wal.K]
ldS0:sLoad[`y14store0.K]
chk["persist-load-store"; qRead[ldS[1];mn1]; (1;tabA1)]
chk["persist-load-wal-clean"; ldW[1][1]; 1]
chk["persist-replay"; qRead[tReplay[ldS0[1];ldW[1][0]][1];mn1]; (1;tabA1)]
wby:wBytes[wal1][1]
torn:((#wby)-3)#wby
`y14torn.K 1: torn
ldT:wLoad[`y14torn.K]
chk["persist-torn"; ldT[1][1]; 0]
:[0=FC[0]; "ALL PASS"; "FAILURES"]
