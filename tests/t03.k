/ Layer 3 tests. Run via run-tests.sh, which feeds the layer chain
/ src/l00.k, src/l01.k, src/l02.k, src/l03.k, then this file to Kona.
/ Each chk prints PASS name or FAIL name. The last line prints
/ ALL PASS only when every check passed.
FC:(,0)
chk:{[n;g;w] m:g~w; FC[0]:FC[0]+(~m); (:[m; "PASS "; "FAIL "]),n}
uw:{[t] t[1]}
rteq:{[x] r:cDecode[uw[cEncode[x]]]; :[r[0]=0; 0; r[1]~x]}
nest:{[n] :[n=0; (oInt[1])[1]; (oList[(,nest[n-1])])[1]]}
wrapn:{[p;n] :[n=0; p; wrapn[(,7),bEncU32[1],p;n-1]]}
raw:{[n] :[n=0; (`int;1); (`list;(,raw[n-1]))]}
mkframe:{[t;p] (75 83 66 43),1,t,bEncU32[#p],p,bEncU32[bCksum[(75 83 66 43),1,t,bEncU32[#p],p]]}
IMX:9223372036854775807
IMN:(-9223372036854775807)-1
chk["rt-int"; rteq[uw[oInt[42]]]; 1]
chk["rt-int-neg"; rteq[uw[oInt[-7]]]; 1]
chk["rt-int-max"; rteq[uw[oInt[IMX]]]; 1]
chk["rt-int-min"; rteq[uw[oInt[IMN]]]; 1]
