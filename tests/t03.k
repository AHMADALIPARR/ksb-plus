chk["rt-intvec-big"; rteq[uw[oIntVec[!10000]]]; 1]
chk["rt-fltvec"; rteq[uw[oFltVec[1.5 2.5]]]; 1]
chk["rt-fltvec-empty"; rteq[uw[oFltVec[0#1.0 2.0]]]; 1]
chk["rt-nest1"; rteq[nest[1]]; 1]
chk["rt-nest5"; rteq[nest[5]]; 1]
chk["rt-nest32"; rteq[nest[32]]; 1]
chk["rt-dict"; rteq[uw[oDict[`a`b;((oInt[1])[1];(oInt[2])[1])]]]; 1]
chk["rt-dict-empty"; rteq[uw[oDict[!0;!0]]]; 1]
chk["rt-dict-nested"; rteq[uw[oDict[(,`a);(,(oList[(,(oInt[1])[1])])[1])]]]; 1]
chk["rt-table"; rteq[uw[oTable[`a`b;(1 2 3;1.5 2.5 3.5)]]]; 1]
chk["rt-table-symcol"; rteq[uw[oTable[(,`a);(,(`x`y`z))]]]; 1]
chk["rt-table-0row"; rteq[uw[oTable[(,`a);(,(!0))]]]; 1]
chk["rt-time-0"; rteq[uw[oTime[0;12345]]]; 1]
chk["rt-time-1"; rteq[uw[oTime[1;999]]]; 1]
chk["rt-time-2"; rteq[uw[oTime[2;86399999999999]]]; 1]
chk["rt-intmat"; rteq[uw[oIntMat[2;3;1 2 3 4 5 6]]]; 1]
chk["rt-fltmat"; rteq[uw[oFltMat[2;2;1.5 2.5 3.5 4.5]]]; 1]
chk["rt-schema"; rteq[uw[oSchema[((`id;`intvec;0);(`nm;`str;1))]]]; 1]
chk["rt-plan"; rteq[uw[oPlan[`select;((oInt[1])[1];(oInt[2])[1])]]]; 1]
chk["rt-plan-0arg"; rteq[uw[oPlan[`select;!0]]]; 1]
chk["rt-ref"; rteq[uw[oRef[2;100;50]]]; 1]
chk["rt-txn"; rteq[uw[oTxn[5;((oInt[1])[1];(oInt[2])[1]);1]]]; 1]
