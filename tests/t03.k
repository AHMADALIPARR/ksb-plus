chk["rt-flt-nan"; rteq[uw[oFlt[0.0%0.0]]]; 1]
chk["rt-flt-inf"; rteq[uw[oFlt[1.0%0.0]]]; 1]
chk["rt-flt-neginf"; rteq[uw[oFlt[-(1.0%0.0)]]]; 1]
chk["rt-str"; rteq[uw[oStr["hello"]]]; 1]
chk["rt-str-empty"; rteq[uw[oStr[""]]]; 1]
chk["rt-sym"; rteq[uw[oSym[`hello]]]; 1]
chk["rt-intvec"; rteq[uw[oIntVec[1 2 3]]]; 1]
