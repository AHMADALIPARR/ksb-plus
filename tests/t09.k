/ Layer 9 tests. Run via run-tests.sh, which feeds the layer chain
/ src/l00.k through src/l09.k, then this file to Kona. Each chk
/ prints PASS name or FAIL name. The last line prints ALL PASS
/ only when every check passed. The counter uses indexed assignment
/ on a global 1-element list (see kona-notes: plain assignment
/ inside chk reads an uninitialized local).
/ Concurrency here means interleaved begins and commits in one
/ session (Kona is single-threaded; there are no threads and no
/ lock manager). Conflict is first-committer-wins at whole-store
/ version granularity: any concurrent commit conflicts, even one
/ touching different records. The file test writes scratch file
/ w9test.K in the current directory (the repo dir under
/ run-tests.sh); it is git-ignored, and saves rewrite it rather
/ than appending, so reruns are clean.
FC:(,0)
chk:{[n;g;w] m:g~w; FC[0]:FC[0]+(~m); (:[m; "PASS "; "FAIL "]),n}
fr1:bFrame[7;_ic "rec1"]
fr2:bFrame[7;_ic "rec2"]
fr3:bFrame[7;_ic "rec3"]
fr4:bFrame[7;_ic "rec4"]
t0:(1;0;0;sNew;!0)
chk["begin-ok"; tBegin[sNew;0;1]; (1;t0)]
chk["begin-badstore"; tBegin[5;0;1]; (0;"type")]
chk["begin-badver-neg"; tBegin[sNew;-1;1]; (0;"type")]
chk["begin-badver-type"; tBegin[sNew;"x";1]; (0;"type")]
chk["begin-badid"; tBegin[sNew;0;-1]; (0;"type")]
chk["istxn-good"; tIsTxn[t0]; 1]
chk["istxn-badlen"; tIsTxn[(1;0;0;sNew)]; 0]
chk["istxn-badstatus"; tIsTxn[(1;3;0;sNew;!0)]; 0]
chk["istxn-badwork"; tIsTxn[(1;0;0;5;!0)]; 0]
chk["istxn-wrongowner"; tIsTxn[(1;0;0;sNew;,(`put;2;fr1))]; 0]
chk["istxn-markentry"; tIsTxn[(1;0;0;sNew;,(`commit;1;!0))]; 0]
chk["istxn-badframe"; tIsTxn[(1;0;0;sNew;,(`put;1;1 2 3))]; 0]
chk["istxn-badid-type"; tIsTxn[("x";0;0;sNew;!0)]; 0]
chk["istxn-badstatus-type"; tIsTxn[(1;"x";0;sNew;!0)]; 0]
chk["istxn-badver-type"; tIsTxn[(1;0;"x";sNew;!0)]; 0]
chk["istxn-entry-badowner-type"; tIsTxn[(1;0;0;sNew;,(`put;"x";fr1))]; 0]
chk["begin-badid-type"; tBegin[sNew;0;"x"]; (0;"type")]
chk["id-ok"; tId[t0]; (1;1)]
chk["id-bad"; tId[5]; (0;"shape")]
chk["status-ok"; tStatus[t0]; (1;0)]
chk["ver-ok"; tVer[t0]; (1;0)]
p0:tPut[t0;fr1]
chk["put-recs"; tRecs[p0[1]]; (1;1)]
chk["put-read-own"; tGet[p0[1];0;0]; (1;fr1)]
chk["put-shared-untouched"; sRecs[sNew]; (1;0)]
chk["put-badframe"; tPut[t0;1 2 3]; (0;"valid")]
chk["put-nontype"; tPut[t0;5]; (0;"type")]
chk["put-badtxn"; tPut[5;fr1]; (0;"shape")]
A:tBegin[sNew;0;1]
A1:tPut[A[1];fr1]
A2:tPut[A1[1];fr2]
C:tCommit[A2[1];sNew;0;wNew]
chk["commit-txn-status"; tStatus[C[1][0]]; (1;1)]
chk["commit-store-recs"; sRecs[C[1][1]]; (1;2)]
chk["commit-store-get0"; sGet[C[1][1];0;0]; (1;fr1)]
chk["commit-store-get1"; sGet[C[1][1];0;1]; (1;fr2)]
chk["commit-version"; C[1][2]; 1]
walC:(3;((0;`put;1;fr1);(1;`put;1;fr2);(2;`commit;1;!0)))
chk["commit-wal"; wRecover[(wBytes[C[1][3]])[1]]; (1;(walC;1))]
chk["commit-again"; tCommit[C[1][0];C[1][1];C[1][2];C[1][3]]; (0;"status")]
chk["commit-badver-type"; tCommit[A2[1];sNew;"x";wNew]; (0;"type")]
chk["commit-badstore"; tCommit[A2[1];5;0;wNew]; (0;"type")]
chk["commit-badwal"; tCommit[A2[1];sNew;0;5]; (0;"shape")]
XA:tBegin[sNew;0;1]
XB:tBegin[sNew;0;2]
XA1:tPut[XA[1];fr1]
CX:tCommit[XA1[1];sNew;0;wNew]
XB1:tPut[XB[1];fr2]
chk["conflict-diff-records"; tCommit[XB1[1];CX[1][1];CX[1][2];CX[1][3]]; (0;"conflict")]
chk["shared-unchanged"; sRecs[CX[1][1]]; (1;1)]
chk["snapshot-own-write"; tGet[XB1[1];0;0]; (1;fr2)]
chk["snapshot-no-others-write"; tGet[XB1[1];0;1]; (0;"bounds")]
AB:tAbort[XB1[1];CX[1][3]]
chk["abort-status"; tStatus[AB[1][0]]; (1;2)]
recAB:wRecover[(wBytes[AB[1][1]])[1]]
chk["abort-wal-seq"; recAB[1][0][0]; 3]
chk["abort-wal-entry"; recAB[1][0][1][2]; (2;`abort;2;!0)]
chk["abort-again"; tAbort[AB[1][0];AB[1][1]]; (0;"status")]
chk["commit-aborted"; tCommit[AB[1][0];CX[1][1];CX[1][2];AB[1][1]]; (0;"status")]
chk["put-aborted"; tPut[AB[1][0];fr3]; (0;"status")]
B2:tBegin[CX[1][1];CX[1][2];2]
B3:tPut[B2[1];fr2]
CB:tCommit[B3[1];CX[1][1];CX[1][2];AB[1][1]]
chk["retry-store-recs"; sRecs[CB[1][1]]; (1;2)]
chk["retry-version"; CB[1][2]; 2]
chk["retry-get1"; sGet[CB[1][1];0;1]; (1;fr2)]
recCB:wRecover[(wBytes[CB[1][3]])[1]]
chk["retry-wal-seq"; recCB[1][0][0]; 5]
rw1:wAppend[wNew;`put;-1;fr1]
rw2:wAppend[rw1[1];`put;7;fr2]
rw3:wAppend[rw2[1];`put;8;fr3]
rw4:wAppend[rw3[1];`commit;8;!0]
rw5:wAppend[rw4[1];`put;9;fr4]
rw6:wAppend[rw5[1];`abort;9;!0]
rp:tReplay[sNew;rw6[1]]
chk["replay-recs"; sRecs[rp[1]]; (1;2)]
chk["replay-get0"; sGet[rp[1];0;0]; (1;fr1)]
chk["replay-get1"; sGet[rp[1];0;1]; (1;fr3)]
chk["replay-badstore"; tReplay[5;rw6[1]]; (0;"type")]
chk["replay-badwal"; tReplay[sNew;5]; (0;"shape")]
chk["replay-empty"; tReplay[sNew;wNew]; (1;sNew)]
bigf:bFrame[7;5000#65]
bigw:wAppend[wNew;`put;-1;bigf]
chk["replay-limit"; tReplay[sNew;bigw[1]]; (0;"limit")]
CA:tBegin[sNew;0;1]
CA1:tPut[CA[1];fr1]
CCA:tCommit[CA1[1];sNew;0;wNew]
CB2:tBegin[sNew;0;2]
CB3:tPut[CB2[1];fr2]
chk["crash-save"; wSave[CCA[1][3];"w9test"]; (1;"w9test")]
ld9:wLoad["w9test"]
rb9:tReplay[sNew;ld9[1][0]]
chk["crash-recs"; sRecs[rb9[1]]; (1;1)]
chk["crash-get0"; sGet[rb9[1];0;0]; (1;fr1)]
:[0=FC[0]; "ALL PASS"; "FAILURES"]
