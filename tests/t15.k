/ Layer 15 tests. Run via run-tests.sh, which feeds the layer chain
/ src/l00.k through src/l15.k, then this file to Kona. Each chk
/ prints PASS name or FAIL name. The last line prints ALL PASS
/ only when every check passed. The counter uses indexed assignment
/ on a global 1-element list (see kona-notes: plain assignment
/ inside chk reads an uninitialized local). Single-element lists
/ must be enlisted with ,(...) -- a bare atom is not a vector.
/ File paths are symbols; Kona appends .K only when absent, and
/ these names already end in .K. Test files are git-ignored.
/ Two-pair envs need no enlist: ((`a;x);(`b;y)) is already a
/ list of two pairs; enlisting only the first pair breaks lookup.
FC:(,0)
chk:{[n;g;w] m:g~w; FC[0]:FC[0]+(~m); (:[m; "PASS "; "FAIL "]),n}
ut:nUserNew[`alice`bob;("pw1";"pw2")][1]
chk["user-new"; nUserNew[`alice`bob;("pw1";"pw2")]; (1;ut)]
chk["user-new-empty"; nUserNew[0#`a;!0]; (1;oTable[`user`hash;((0#`a);!0)][1])]
chk["user-new-dup"; nUserNew[`a`a;("xx";"yy")]; (0;"key")]
chk["user-new-len"; nUserNew[`a`b;(,("xx"))]; (0;"shape")]
chk["user-new-badtype-users"; nUserNew[1 2;("xx";"yy")]; (0;"type")]
chk["user-new-badtype-passes"; nUserNew[`a`b;("xx";42)]; (0;"type")]
chk["user-new-flatpass"; nUserNew[`a`b;"pw"]; (0;"type")]
chk["auth-good"; nAuth[ut;`alice;"pw1"]; (1;1)]
chk["auth-bad"; nAuth[ut;`alice;"nope"]; (1;0)]
chk["auth-unknown"; nAuth[ut;`mallory;"pw1"]; (1;0)]
chk["auth-badtype-user"; nAuth[ut;"alice";"pw1"]; (0;"type")]
chk["auth-badtype-pass"; nAuth[ut;`alice;`pw1]; (0;"type")]
chk["auth-nontab"; nAuth[42;`alice;"pw1"]; (0;"type")]
ur:nRoleNew[`alice`bob`alice;`admin`user`auditor][1]
pt0:nPermNew[1]
pt1:nGrant[pt0;`admin;`acct;`read][1]
pt2:nGrant[pt1;`admin;`acct;`write][1]
pt3:nGrant[pt2;`user;`acct;`read][1]
pt4:nGrant[pt3;`auditor;`audit;`read][1]
chk["role-new"; nRoleNew[`alice`bob`alice;`admin`user`auditor]; (1;ur)]
chk["role-new-badlen"; nRoleNew[`a`b;,`r]; (0;"shape")]
chk["role-new-badtype"; nRoleNew[`a;1]; (0;"type")]
chk["can-alice-read"; nCan[pt4;ur;`alice;`acct;`read]; (1;1)]
chk["can-alice-write"; nCan[pt4;ur;`alice;`acct;`write]; (1;1)]
chk["can-bob-read"; nCan[pt4;ur;`bob;`acct;`read]; (1;1)]
chk["can-bob-write"; nCan[pt4;ur;`bob;`acct;`write]; (1;0)]
chk["can-bob-audit"; nCan[pt4;ur;`bob;`audit;`read]; (1;0)]
chk["can-alice-audit"; nCan[pt4;ur;`alice;`audit;`read]; (1;1)]
chk["can-unknown"; nCan[pt4;ur;`mallory;`acct;`read]; (1;0)]
chk["can-badtype"; nCan[pt4;ur;"alice";`acct;`read]; (0;"type")]
chk["grant-badtab"; nGrant[ut;`admin;`acct;`read]; (0;"shape")]
chk["grant-badtype"; nGrant[pt0;`admin;`acct;"read"]; (0;"type")]
pt5:nRevoke[pt4;`admin;`acct;`write][1]
chk["revoke-write"; nCan[pt5;ur;`alice;`acct;`write]; (1;0)]
chk["revoke-read-kept"; nCan[pt5;ur;`alice;`acct;`read]; (1;1)]
chk["revoke-nomatch"; nRevoke[pt4;`user;`acct;`write]; (1;pt4)]
au0:nAuditNew[1]
au1:nAuditAppend[au0;`alice;`read;`acct;1][1]
au2:nAuditAppend[au1;`bob;`write;`acct;0][1]
auT:oTable[`seq`user`op`obj`allowed;(0 2;`alice`bob;`read`write;`acct`acct;1 0)][1]
auA:oTable[`seq`user`op`obj`allowed;(0 1;`alice`bob;`read`write;`acct`acct;1 2)][1]
chk["audit-append"; nAuditAppend[au0;`alice;`read;`acct;1]; (1;au1)]
chk["audit-seq"; oCol[au2;`seq]; (1;0 1)]
chk["audit-verify-good"; nAuditVerify[au2]; (1;1)]
chk["audit-verify-empty"; nAuditVerify[au0]; (1;1)]
chk["audit-verify-badseq"; nAuditVerify[auT]; (1;0)]
chk["audit-verify-badallowed"; nAuditVerify[auA]; (1;0)]
chk["audit-verify-nontab"; nAuditVerify[42]; (0;"type")]
chk["audit-verify-wrongnames"; nAuditVerify[ut]; (1;0)]
chk["audit-append-badallowed"; nAuditAppend[au0;`alice;`read;`acct;2]; (0;"range")]
chk["audit-append-badtype"; nAuditAppend[au0;`alice;`read;`acct;`yes]; (0;"type")]
bk0:nRateNew[1]
bk1:oTable[`user`tokens`last;((,`alice);(,2);(,100))][1]
bk2:oTable[`user`tokens`last;((,`alice);(,1);(,100))][1]
bk3:oTable[`user`tokens`last;((,`alice);(,0);(,100))][1]
bk5:oTable[`user`tokens`last;((,`alice);(,1);(,102))][1]
bk6:oTable[`user`tokens`last;((,`alice);(,2);(,200))][1]
bk8:oTable[`user`tokens`last;(`alice`bob;1 2;102 50)][1]
chk["rate-new"; nRateAllow[bk0;`alice;100;1;3]; (1;(1;bk1))]
chk["rate-drain1"; nRateAllow[bk1;`alice;100;1;3]; (1;(1;bk2))]
chk["rate-drain2"; nRateAllow[bk2;`alice;100;1;3]; (1;(1;bk3))]
chk["rate-deny"; nRateAllow[bk3;`alice;100;1;3]; (1;(0;bk3))]
chk["rate-refill"; nRateAllow[bk3;`alice;102;1;3]; (1;(1;bk5))]
chk["rate-cap"; nRateAllow[bk5;`alice;200;1;3]; (1;(1;bk6))]
chk["rate-backward"; nRateAllow[bk5;`alice;101;1;3]; (0;"range")]
chk["rate-newuser"; nRateAllow[bk5;`bob;50;1;3]; (1;(1;bk8))]
chk["rate-badtype"; nRateAllow[bk0;`alice;"100";1;3]; (0;"type")]
chk["rate-badrange-cap"; nRateAllow[bk0;`alice;100;1;0]; (0;"range")]
chk["rate-badrange-ts"; nRateAllow[bk0;`alice;-1;1;3]; (0;"range")]
tabQ:oTable[`acct`bal;(100 200;1000 2000)][1]
tabL:oTable[`acct`x;(100 200;10 20)][1]
tabR:oTable[`acct`y;(100 200;1000 2000)][1]
envQ:(,(`a;tabQ))
envQ2:((`a;tabQ);(`b;tabQ))
envJ:((`a;tabL);(`b;tabR))
ptQ0:nPermNew[1]
ptQ1:nGrant[ptQ0;`admin;`a;`read][1]
ptQ2:nGrant[ptQ1;`user;`a;`read][1]
ptQ3:nGrant[ptQ2;`user;`b;`read][1]
chk["authq-allow"; nAuthQ[envQ;ptQ2;ur;`alice;"select acct, bal from a where bal > 1500"]; (1;oTable[`acct`bal;((,200);(,2000))][1])]
chk["authq-deny"; nAuthQ[envQ2;ptQ2;ur;`bob;"select acct, bal from b"]; (0;"denied")]
chk["authq-allow-exec"; nAuthQ[envQ;ptQ2;ur;`bob;"exec bal from a where acct = 100"]; (1;,1000)]
chk["authq-deny-exec"; nAuthQ[envQ2;ptQ2;ur;`bob;"exec bal from b where acct = 100"]; (0;"denied")]
chk["authq-badquery"; nAuthQ[envQ;ptQ2;ur;`alice;"select from"]; (0;"parse")]
chk["authsql-allow"; nAuthSQL[envQ;ptQ2;ur;`alice;"select acct, bal from a where bal >= 1500"]; (1;oTable[`acct`bal;((,200);(,2000))][1])]
chk["authsql-deny"; nAuthSQL[envQ2;ptQ2;ur;`bob;"select acct, bal from b"]; (0;"denied")]
chk["authsql-join-deny"; nAuthSQL[envJ;ptQ2;ur;`bob;"select a.acct, a.x, b.y from a join b on a.acct = b.acct"]; (0;"denied")]
chk["authsql-join-allow"; nAuthSQL[envJ;ptQ3;ur;`bob;"select a.acct, a.x, b.y from a join b on a.acct = b.acct"]; (1;oTable[`acct`x`y;(100 200;10 20;1000 2000)][1])]
spQ:qSplitTable[tabQ]
wrQ:qWrite[sNew;spQ[1]]
stQ:wrQ[1][0]
mnQ:wrQ[1][1]
trQ:yTxTransfer[stQ;mnQ;0;wNew;7;100;200;250]
stQ1:trQ[1][0]
mnQ1:trQ[1][1]
walQ:trQ[1][3]
tabQ1:yTransfer[tabQ;100;200;250][1]
chk["ops-backup"; nBackup[stQ1;walQ;`n15store.K;`n15wal.K]; (1;(`n15store.K;`n15wal.K))]
rs:nRestore[`n15store.K;`n15wal.K]
chk["ops-restore"; rs; (1;(stQ1;walQ;1))]
chk["ops-restore-replay"; qRead[tReplay[stQ;rs[1][1]][1];mnQ1]; (1;tabQ1)]
chk["ops-checkpoint"; nCheckpoint[stQ;walQ]; (1;(stQ1;wNew))]
chk["ops-verify-store"; nVerifyStore[stQ1]; (1;(1;4;1))]
chk["ops-verify-store-bad"; nVerifyStore[42]; (0;"type")]
chk["ops-backup-badstore"; nBackup[42;walQ;`n15bad.K;`n15badw.K]; (0;"type")]
chk["quota-ok"; nQuota[tabQ;2]; (1;1)]
chk["quota-over"; nQuota[tabQ;1]; (0;"limit")]
chk["quota-zero"; nQuota[tabQ;0]; (0;"limit")]
chk["quota-empty"; nQuota[oTable[`acct`bal;(!0;!0)][1];0]; (1;1)]
chk["quota-badtype"; nQuota[42;2]; (0;"type")]
chk["quota-badmax"; nQuota[tabQ;`x]; (0;"type")]
chk["quota-negmax"; nQuota[tabQ;-1]; (0;"range")]
:[0=FC[0]; "ALL PASS"; "FAILURES"]
