/ Layer 12 tests. Run via run-tests.sh, which feeds the layer chain
/ src/l00.k through src/l12.k, then this file to Kona. Each chk
/ prints PASS name or FAIL name. The last line prints ALL PASS
/ only when every check passed. The counter uses indexed assignment
/ on a global 1-element list (see kona-notes: plain assignment
/ inside chk reads an uninitialized local).
/ Q is lowercase and case-sensitive; identifiers are case-sensitive.
/ Env is a list of (name;value) pairs; a value is a table object
/ or a (store;manifest) pair. Enlist single pairs with ,(...) --
/ a pair in parens alone is grouping, not enlist (see kona-notes).
FC:(,0)
chk:{[n;g;w] m:g~w; FC[0]:FC[0]+(~m); (:[m; "PASS "; "FAIL "]),n}
tab:oTable[`id`val`nm;(10 20 30;1.5 2.5 3.5;`a`b`c)]
env:(,(`t;tab[1]))
sp:qSplitTable[tab[1]]
wr:qWrite[sNew;sp[1]]
envS:(,(`s;wr[1]))
chk["tok-basic"; uTok["select id from t"]; (1;((`w;"select");(`w;"id");(`w;"from");(`w;,"t")))]
chk["tok-ops-le"; uTok["a<=b"]; (1;((`w;,"a");(`p;"<=");(`w;,"b")))]
chk["tok-ops-gt"; uTok["a>b"]; (1;((`w;,"a");(`p;uP_GT);(`w;,"b")))]
chk["tok-ops-ne"; uTok["a!=b"]; (1;((`w;,"a");(`p;uP_NE);(`w;,"b")))]
chk["tok-ops-ned"; uTok["a<>b"]; (1;((`w;,"a");(`p;uP_NED);(`w;,"b")))]
chk["tok-int"; uTok["id=20"]; (1;((`w;"id");(`p;uP_EQ);(`i;20)))]
chk["tok-negfloat"; uTok["v<-1.5"]; (1;((`w;,"v");(`p;uP_LT);(`p;uP_MINUS);(`f;1.5)))]
chk["tok-exp"; uTok["v>2.5e-1"]; (1;((`w;,"v");(`p;uP_GT);(`f;0.25)))]
chk["tok-exp-int"; uTok["v=1e3"]; (1;((`w;,"v");(`p;uP_EQ);(`f;1000.0)))]
chk["tok-string"; uTok["nm=\"a\""]; (1;((`w;"nm");(`p;uP_EQ);(`s;,"a")))]
chk["tok-string-multi"; uTok["nm=\"hello\""]; (1;((`w;"nm");(`p;uP_EQ);(`s;"hello")))]
chk["tok-string-empty"; uTok["nm=\"\""]; (1;((`w;"nm");(`p;uP_EQ);(`s;"")))]
chk["tok-sym"; uTok["nm=`b"]; (1;((`w;"nm");(`p;uP_EQ);(`y;`b)))]
chk["tok-star"; uTok["select * from t"]; (1;((`w;"select");(`p;uP_STAR);(`w;"from");(`w;,"t")))]
chk["tok-comma-dot"; uTok["a,b.c"]; (1;((`w;,"a");(`p;uP_COMMA);(`w;,"b");(`p;uP_DOT);(`w;,"c")))]
chk["tok-name-underscore"; uTok["select my_col from t"]; (1;((`w;"select");(`w;"my_col");(`w;"from");(`w;,"t")))]
chk["tok-empty"; uTok[""]; (1;!0)]
chk["tok-ws-only"; uTok["   "]; (1;!0)]
chk["tok-unterm"; uTok["nm=\"abc"]; (0;"parse")]
chk["tok-badchar"; uTok["a@b"]; (0;"parse")]
chk["tok-dotnum"; uTok["v>.5"]; (1;((`w;,"v");(`p;uP_GT);(`p;uP_DOT);(`i;5)))]
chk["q-sel-dotnum"; uQ[env;"select id from t where val>.5"]; (0;"parse")]
chk["tok-longint"; uTok["v=1234567890123456789"]; (0;"parse")]
chk["q-sel-basic"; uQ[env;"select id,val from t where val>2.0"]; (1;oTable[`id`val;(20 30;2.5 3.5)][1])]
chk["q-sel-star"; uQ[env;"select * from t"]; (1;tab[1])]
chk["q-sel-nocols"; uQ[env;"select from t"]; (1;tab[1])]
chk["q-sel-lt"; uQ[env;"select id from t where id<20"]; (1;oTable[(,`id);(,(,10))][1])]
chk["q-sel-le"; uQ[env;"select id from t where id<=20"]; (1;oTable[(,`id);(,(10 20))][1])]
chk["q-sel-eq"; uQ[env;"select id from t where id=20"]; (1;oTable[(,`id);(,(,20))][1])]
chk["q-sel-ge"; uQ[env;"select id from t where id>=20"]; (1;oTable[(,`id);(,(20 30))][1])]
chk["q-sel-gt"; uQ[env;"select id from t where id>20"]; (1;oTable[(,`id);(,(,30))][1])]
chk["q-sel-ne"; uQ[env;"select id from t where id!=20"]; (1;oTable[(,`id);(,(10 30))][1])]
chk["q-sel-ne-alt"; uQ[env;"select id from t where id<>20"]; (1;oTable[(,`id);(,(10 30))][1])]
chk["q-sel-sym"; uQ[env;"select nm from t where nm=`b"]; (1;oTable[(,`nm);(,(,`b))][1])]
chk["q-sel-multi"; uQ[env;"select id from t where val>2.0, id<30"]; (1;oTable[(,`id);(,(,20))][1])]
chk["q-sel-exp"; uQ[env;"select id from t where val>2.5e-1"]; (1;oTable[(,`id);(,(10 20 30))][1])]
chk["q-sel-neg"; uQ[env;"select id from t where val<-1.0"]; (1;oTable[(,`id);(,(!0))][1])]
chk["q-sel-str-type"; uQ[env;"select id from t where nm=\"a\""]; (0;"type")]
chk["q-sel-unknown-tab"; uQ[env;"select id from zz"]; (0;"key")]
chk["q-sel-unknown-col"; uQ[env;"select zz from t"]; (0;"key")]
chk["q-sel-unknown-predcol"; uQ[env;"select id from t where zz=1"]; (0;"key")]
chk["q-sel-uppercase"; uQ[env;"SELECT id from t"]; (0;"parse")]
chk["q-sel-trailing"; uQ[env;"select id from t extra"]; (0;"parse")]
chk["q-sel-nofrom"; uQ[env;"select id t"]; (0;"parse")]
chk["q-sel-empty"; uQ[env;""]; (0;"parse")]
chk["q-sel-badwhere"; uQ[env;"select id from t where val>"]; (0;"parse")]
chk["q-sel-empty-where"; uQ[env;"select id from t where"]; (0;"parse")]
chk["q-sel-trail-comma"; uQ[env;"select id from t where id>10,"]; (0;"parse")]
chk["q-sel-minus-str"; uQ[env;"select id from t where nm=-\"a\""]; (0;"parse")]
chk["q-sel-qual-cols"; uQ[env;"select t.id from t"]; (0;"parse")]
chk["q-sel-qual-pred"; uQ[env;"select id from t where t.id=20"]; (0;"parse")]
chk["q-sel-badop"; uQ[env;"select id from t where id~20"]; (0;"parse")]
chk["q-sel-case-col"; uQ[env;"select ID from t"]; (0;"key")]
chk["q-exec-basic"; uQ[env;"exec val from t where id>=20"]; (1;2.5 3.5)]
chk["q-exec-nopred"; uQ[env;"exec id from t"]; (1;10 20 30)]
chk["q-exec-sym"; uQ[env;"exec nm from t where id=20"]; (1;,`b)]
chk["q-exec-badcol"; uQ[env;"exec zz from t"]; (0;"key")]
chk["q-exec-unknown-tab"; uQ[env;"exec id from zz"]; (0;"key")]
chk["q-store-scan"; uQ[envS;"select id from s where val>2.0"]; (1;oTable[(,`id);(,(20 30))][1])]
chk["q-store-read"; uQ[envS;"select nm from s"]; (1;oTable[(,`nm);(,( `a`b`c))][1])]
chk["q-store-multi"; uQ[envS;"select id,val from s where val>1.0, id>=20"]; (1;oTable[`id`val;(20 30;2.5 3.5)][1])]
chk["q-store-exec"; uQ[envS;"exec id from s where val>=2.5"]; (1;20 30)]
chk["q-store-star-pred"; uQ[envS;"select * from s where id>10"]; (1;oTable[`id`val`nm;(20 30;2.5 3.5;`b`c)][1])]
chk["q-store-badcol"; uQ[envS;"select zz from s"]; (0;"key")]
chk["q-store-badpred"; uQ[envS;"select id from s where zz=1"]; (0;"key")]
:[0=FC[0]; "ALL PASS"; "FAILURES"]
