/ Layer 11 tests. Run via run-tests.sh, which feeds the layer chain
/ src/l00.k through src/l11.k, then this file to Kona. Each chk
/ prints PASS name or FAIL name. The last line prints ALL PASS
/ only when every check passed. The counter uses indexed assignment
/ on a global 1-element list (see kona-notes: plain assignment
/ inside chk reads an uninitialized local).
/ Float expectations keep .0 decimals: Kona ~ distinguishes float
/ from int, so an expected float cell must be written as a float.
FC:(,0)
chk:{[n;g;w] m:g~w; FC[0]:FC[0]+(~m); (:[m; "PASS "; "FAIL "]),n}
A:oIntMat[2;2;1 2 3 4]
B:oIntMat[2;2;5 6 7 8]
C:oIntMat[2;3;1 2 3 4 5 6]
D:oIntMat[3;2;1 2 3 4 5 6]
F:oFltMat[2;2;1.5 2.5 3.5 4.5]
badM:(`intmat;(2;2;1 2 3))
chk["trans-int"; mTranspose[A[1]]; (1;oIntMat[2;2;1 3 2 4][1])]
chk["trans-nonsquare"; mTranspose[C[1]]; (1;oIntMat[3;2;1 4 2 5 3 6][1])]
chk["trans-twice"; mTranspose[mTranspose[A[1]][1]]; (1;A[1])]
chk["trans-float"; mTranspose[F[1]]; (1;oFltMat[2;2;1.5 3.5 2.5 4.5][1])]
chk["trans-nonmat"; mTranspose[5]; (0;"type")]
chk["add-basic"; mAdd[A[1];B[1]]; (1;oIntMat[2;2;6 8 10 12][1])]
chk["add-float"; mAdd[F[1];F[1]]; (1;oFltMat[2;2;3.0 5.0 7.0 9.0][1])]
chk["add-shape"; mAdd[A[1];C[1]]; (0;"shape")]
chk["add-kind"; mAdd[A[1];F[1]]; (0;"type")]
chk["add-malformed"; mAdd[A[1];badM]; (0;"valid")]
chk["add-nonmat"; mAdd[A[1];5]; (0;"type")]
chk["sub-basic"; mSub[B[1];A[1]]; (1;oIntMat[2;2;4 4 4 4][1])]
chk["sub-float"; mSub[F[1];F[1]]; (1;oFltMat[2;2;0.0 0.0 0.0 0.0][1])]
chk["scale-int"; mScale[A[1];3]; (1;oIntMat[2;2;3 6 9 12][1])]
chk["scale-zero"; mScale[A[1];0]; (1;oIntMat[2;2;0 0 0 0][1])]
chk["scale-float"; mScale[F[1];2.0]; (1;oFltMat[2;2;3.0 5.0 7.0 9.0][1])]
chk["scale-badscalar"; mScale[A[1];2.5]; (0;"type")]
chk["scale-badscalar2"; mScale[A[1];"x"]; (0;"type")]
chk["mul-basic"; mMul[A[1];B[1]]; (1;oIntMat[2;2;19 22 43 50][1])]
chk["mul-nonsquare"; mMul[C[1];D[1]]; (1;oIntMat[2;2;22 28 49 64][1])]
chk["mul-nonsquare2"; mMul[D[1];C[1]]; (1;oIntMat[3;3;9 12 15 19 26 33 29 40 51][1])]
chk["mul-float"; mMul[F[1];F[1]]; (1;oFltMat[2;2;11.0 15.0 21.0 29.0][1])]
chk["mul-ident-left"; mMul[mIdentI[2][1];A[1]]; (1;A[1])]
chk["mul-ident-right"; mMul[A[1];mIdentI[2][1]]; (1;A[1])]
chk["mul-shape"; mMul[A[1];oIntMat[3;3;1 2 3 4 5 6 7 8 9][1]]; (0;"shape")]
chk["mul-kind"; mMul[A[1];F[1]]; (0;"type")]
chk["mul-malformed"; mMul[A[1];badM]; (0;"valid")]
M1:oIntMat[1;1;,kIMAX]
M2:oIntMat[1;1;,2]
M3:oIntMat[1;1;,1]
chk["mul-overflow"; mMul[M1[1];M2[1]]; (0;"overflow")]
chk["add-overflow"; mAdd[M1[1];M3[1]]; (0;"overflow")]
chk["scale-overflow"; mScale[M1[1];2]; (0;"overflow")]
chk["vecmul-int"; mVecMul[A[1];10 20]; (1;50 110)]
chk["vecmul-nonsquare"; mVecMul[C[1];1 2 3]; (1;14 32)]
chk["vecmul-float"; mVecMul[F[1];2.0 4.0]; (1;13.0 25.0)]
chk["vecmul-badlen"; mVecMul[A[1];10 20 30]; (0;"shape")]
chk["vecmul-badtype"; mVecMul[A[1];1.0 2.0]; (0;"type")]
chk["dot-int"; mDot[1 2 3;4 5 6]; (1;32)]
chk["dot-float"; mDot[1.5 2.5;2.0 4.0]; (1;13.0)]
chk["dot-badlen"; mDot[1 2;1 2 3]; (0;"shape")]
chk["dot-badtype"; mDot[1 2;1.0 2.0]; (0;"type")]
chk["dot-overflow"; mDot[,kIMAX;,2]; (0;"overflow")]
chk["ident-int3"; mIdentI[3]; (1;oIntMat[3;3;1 0 0 0 1 0 0 0 1][1])]
chk["ident-float2"; mIdentF[2]; (1;oFltMat[2;2;1.0 0.0 0.0 1.0][1])]
chk["ident-badn"; mIdentI[0]; (0;"range")]
chk["ident-badtype"; mIdentI["x"]; (0;"type")]
chk["trace-int"; mTrace[A[1]]; (1;5)]
chk["trace-float"; mTrace[F[1]]; (1;6.0)]
chk["trace-nonsquare"; mTrace[C[1]]; (0;"shape")]
chk["row-0"; mRow[A[1];0]; (1;1 2)]
chk["row-1"; mRow[A[1];1]; (1;3 4)]
chk["row-bounds"; mRow[A[1];2]; (0;"bounds")]
chk["row-neg"; mRow[A[1];-1]; (0;"bounds")]
chk["row-badtype"; mRow[A[1];"x"]; (0;"type")]
chk["col-0"; mCol[A[1];0]; (1;1 3)]
chk["col-1"; mCol[A[1];1]; (1;2 4)]
chk["col-bounds"; mCol[A[1];2]; (0;"bounds")]
chk["col-float"; mCol[F[1];1]; (1;2.5 4.5)]
chk["eq-same"; mEq[A[1];A[1]]; (1;1)]
chk["eq-diff"; mEq[A[1];B[1]]; (1;0)]
chk["eq-kind"; mEq[A[1];F[1]]; (1;0)]
chk["eq-nonmat"; mEq[A[1];5]; (0;"type")]
chk["eq-malformed"; mEq[A[1];badM]; (0;"valid")]
:[0=FC[0]; "ALL PASS"; "FAILURES"]
