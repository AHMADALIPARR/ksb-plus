/ Layer 8 tests. Run via run-tests.sh, which feeds the layer chain
/ src/l00.k through src/l08.k, then this file to Kona. Each chk
/ prints PASS name or FAIL name. The last line prints ALL PASS
/ only when every check passed. The counter uses indexed assignment
/ on a global 1-element list (see kona-notes: plain assignment
/ inside chk reads an uninitialized local).
/ File tests write scratch files w8test.K, w8a.K, w8b.K in the
/ current directory (the repo dir under run-tests.sh); they are
/ git-ignored, and saves rewrite them rather than appending, so
/ reruns are clean. Crash tests drop the store and rebuild it
/ from the log alone; rebuilt stores are verified per record
/ (sRecs, sGet), never by a whole-store match.
FC:(,0)
chk:{[n;g;w] m:g~w; FC[0]:FC[0]+(~m); (:[m; "PASS "; "FAIL "]),n}
uw:{[t] t[1]}
fr1:bFrame[7;_ic "rec1"]
fr2:bFrame[7;_ic "rec2"]
e0:(0;`put;-1;fr1)
e1:(1;`put;-1;fr2)
e2:(2;`commit;9;!0)
wal2:(2;(e0;e1))
wal3:(3;(e0;e1;e2))
chk["new-shape"; wNew; (0;!0)]
chk["iswal-empty"; wIsWal[wNew]; 1]
chk["iswal-badseq"; wIsWal[(-1;!0)]; 0]
chk["iswal-put-noframe"; wIsWal[(1;,(0;`put;-1;!0))]; 0]
chk["iswal-badop"; wIsWal[(1;,(0;`nope;-1;!0))]; 0]
chk["iswal-badtxn"; wIsWal[(1;,(0;`commit;-2;!0))]; 0]
chk["iswal-markdata"; wIsWal[(1;,(0;`commit;5;fr1))]; 0]
chk["iswal-good"; wIsWal[wal3]; 1]
chk["seqok-good"; wSeqOk[wal3]; 1]
chk["seqok-gap"; wSeqOk[(2;(e0;e2))]; 0]
chk["iswal-gapstruct"; wIsWal[(2;(e0;e2))]; 1]
a1:wAppend[wNew;`put;-1;fr1]
chk["append-seq0"; a1; (1;(1;,e0))]
a2:wAppend[a1[1];`put;-1;fr2]
chk["append-seq1"; a2; (1;wal2)]
a3:wAppend[a2[1];`commit;9;!0]
chk["append-seq2"; a3; (1;wal3)]
chk["append-badframe"; wAppend[wNew;`put;-1;1 2 3]; (0;"valid")]
chk["append-markdata"; wAppend[wNew;`commit;5;fr1]; (0;"shape")]
chk["append-badop"; wAppend[wNew;`nope;5;!0]; (0;"op")]
chk["append-badtxn"; wAppend[wNew;`commit;-2;!0]; (0;"type")]
chk["append-nonwal"; wAppend[5;`put;-1;fr1]; (0;"shape")]
chk["append-nonop"; wAppend[wNew;5;-1;!0]; (0;"type")]
chk["append-baddata"; wAppend[wNew;`put;-1;5]; (0;"type")]
chk["bytes-empty"; wBytes[wNew]; (1;!0)]
by:wBytes[wal3]
chk["bytes-recover"; wRecover[by[1]]; (1;(wal3;1))]
chk["verify-good"; wVerify[by[1]]; 1]
chk["verify-empty"; wVerify[!0]; 1]
chk["recover-empty"; wRecover[!0]; (1;((0;!0);1))]
chk["recover-garbage"; wRecover[1 2 3]; (1;((0;!0);0))]
tornA:((#by[1])-5)#by[1]
chk["recover-torn-mid"; wRecover[tornA]; (1;(wal2;0))]
tornB:((#by[1])-1)#by[1]
chk["recover-torn-cksum"; wRecover[tornB]; (1;(wal2;0))]
exact:(#(wFrameEntry[e0]))#by[1]
chk["recover-exact"; wRecover[exact]; (1;((1;,e0);1))]
chk["verify-torn"; wVerify[tornA]; 0]
gapby:wFrameEntry[e0],wFrameEntry[e2]
chk["recover-gap"; wRecover[gapby]; (0;"gap")]
chk["verify-gap"; wVerify[gapby]; 0]
badty:bFrame[88;wEntryBytes[e0]]
chk["recover-badtype"; wRecover[badty]; (0;"type")]
badop:bFrame[87;bEncU32[0],(,9),bEncI32[5],!0]
chk["recover-badop"; wRecover[badop]; (0;"op")]
shortp:bFrame[87;1 2 3]
chk["recover-shortpayload"; wRecover[shortp]; (0;"length")]
badput:bFrame[87;bEncU32[0],(,1),bEncI32[-1],1 2 3]
chk["recover-badput"; wRecover[badput]; (0;"valid")]
markd:bFrame[87;bEncU32[0],(,2),bEncI32[5],1 2 3]
chk["recover-markdata"; wRecover[markd]; (0;"shape")]
badtxn:bFrame[87;bEncU32[0],(,2),bEncI32[-2],!0]
chk["recover-badtxn"; wRecover[badtxn]; (0;"type")]
cor1:kByteSet[by[1];51;bMod[(by[1])[51]+1;256]]
chk["recover-corrupt2"; wRecover[cor1[1]]; (1;((1;,e0);0))]
cor0:kByteSet[by[1];10;bMod[(by[1])[10]+1;256]]
chk["recover-corrupt1"; wRecover[cor0[1]]; (1;((0;!0);0))]
chk["apply-empty"; wApply[sNew;wNew]; (1;!0)]
ap:wApply[sNew;wal3]
chk["apply-recs"; sRecs[ap[1]]; (1;2)]
chk["apply-get0"; sGet[ap[1];0;0]; (1;fr1)]
chk["apply-get1"; sGet[ap[1];0;1]; (1;fr2)]
monly:wAppend[wNew;`commit;9;!0]
apm:wApply[sNew;monly[1]]
chk["apply-markers-only"; sRecs[apm[1]]; (1;0)]
chk["apply-badstore"; wApply[5;wal3]; (0;"type")]
chk["apply-badwal"; wApply[sNew;5]; (0;"shape")]
bigf:bFrame[7;5000#65]
bigw:wAppend[wNew;`put;-1;bigf]
chk["apply-big-limit"; wApply[sNew;bigw[1]]; (0;"limit")]
ck:wCheckpoint[sNew;wal3]
chk["ckpt-wal"; ck[1][1]; wNew]
chk["ckpt-recs"; sRecs[ck[1][0]]; (1;2)]
chk["ckpt-get1"; sGet[ck[1][0];0;1]; (1;fr2)]
chk["ckpt-badstore"; wCheckpoint[5;wal3]; (0;"type")]
chk["save-ok"; wSave[wal3;"w8test"]; (1;"w8test")]
ld:wLoad["w8test"]
chk["load-ok"; ld; (1;(wal3;1))]
chk["save-badpath"; wSave[wal3;5]; (0;"type")]
chk["load-badpath"; wLoad[5]; (0;"type")]
chk["reset-a"; wSave[wNew;"w8a"]; (1;"w8a")]
chk["create-ok"; wCreateFile["w8a"]; (1;"w8a")]
chk["af-put1"; wAppendFile["w8a";`put;-1;fr1]; (1;"w8a")]
chk["af-put2"; wAppendFile["w8a";`put;-1;fr2]; (1;"w8a")]
chk["af-commit"; wAppendFile["w8a";`commit;9;!0]; (1;"w8a")]
chk["af-load"; wLoad["w8a"]; (1;(wal3;1))]
chk["af-badop"; wAppendFile["w8a";`nope;5;!0]; (0;"op")]
chk["create-again"; wCreateFile["w8a"]; (1;"w8a")]
chk["load-after-create"; wLoad["w8a"]; (1;(wal3;1))]
full:1: "w8a"
"w8a" 1: ((#full)-3)#full
chk["torn-load"; wLoad["w8a"]; (1;(wal2;0))]
chk["torn-append-refused"; wAppendFile["w8a";`commit;9;!0]; (0;"torn")]
chk["repair"; wRepair["w8a"]; (1;wal2)]
chk["load-after-repair"; wLoad["w8a"]; (1;(wal2;1))]
chk["append-after-repair"; wAppendFile["w8a";`commit;9;!0]; (1;"w8a")]
chk["load-final"; wLoad["w8a"]; (1;(wal3;1))]
stA1:sPut[sNew;fr1]
stA:sPut[stA1[1][0];fr2]
rec:wRecover[(wBytes[wal3])[1]]
rb:wApply[sNew;rec[1][0]]
chk["crash-recs"; sRecs[rb[1]]; (1;2)]
chk["crash-get0"; sGet[rb[1];0;0]; (1;fr1)]
chk["crash-get1"; sGet[rb[1];0;1]; (1;fr2)]
chk["crash-save"; wSave[wal3;"w8b"]; (1;"w8b")]
ldb:wLoad["w8b"]
rbb:wApply[sNew;ldb[1][0]]
chk["crash-file-recs"; sRecs[rbb[1]]; (1;2)]
chk["crash-file-get1"; sGet[rbb[1];0;1]; (1;fr2)]
:[0=FC[0]; "ALL PASS"; "FAILURES"]
