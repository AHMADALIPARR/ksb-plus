/ Layer 6 tests. Run via run-tests.sh, which feeds the layer chain
/ src/l00.k through src/l06.k, then this file to Kona. Each chk
/ prints PASS name or FAIL name. The last line prints ALL PASS
/ only when every check passed.
/ Persistence tests write scratch file s6test.K in the current
/ directory (the repo dir under run-tests.sh); it is git-ignored,
/ and saves rewrite it rather than appending, so reruns are clean.
FC:(,0)
chk:{[n;g;w] m:g~w; FC[0]:FC[0]+(~m); (:[m; "PASS "; "FAIL "]),n}
uw:{[t] t[1]}
ids:10 20 30 40 50
vals:1.5 2.5 0.5 3.5 2.5
syms:`b`a`b`c`a
txts:"abcde"
nms:`id`val`sym`txt
tab1:uw[oTable[nms;(ids;vals;syms;txts)]]
sp1:qSplitTable[tab1]
chk["split-ok"; sp1[0]; 1]
chk["split-names"; sp1[1][0]; nms]
chk["split-tags"; sp1[1][1]; 1 2 4 3]
chk["split-nrows"; sp1[1][2]; 5]
chk["split-ncols"; #sp1[1][3]; 4]
chk["split-chunks"; (#sp1[1][3][0];#sp1[1][3][1];#sp1[1][3][2];#sp1[1][3][3]); 1 1 1 1]
wr1:qWrite[sNew;sp1[1]]
chk["write-ok"; wr1[0]; 1]
st1:wr1[1][0]
mn1:wr1[1][1]
chk["write-count"; sCount[st1]; (1;1)]
chk["write-recs"; sRecs[st1]; (1;4)]
chk["man-names"; qNames[mn1]; (1;nms)]
chk["man-rows"; qRows[mn1]; (1;5)]
chk["man-tags"; mn1[1]; 1 2 4 3]
chk["addr-id"; mn1[3][0]; (,(0;0))]
chk["addr-val"; mn1[3][1]; (,(0;1))]
chk["addr-sym"; mn1[3][2]; (,(0;2))]
chk["addr-txt"; mn1[3][3]; (,(0;3))]
chk["read-roundtrip"; qRead[st1;mn1]; (1;tab1)]
chk["col-id"; qColRead[st1;mn1;`id]; (1;ids)]
chk["col-val"; qColRead[st1;mn1;`val]; (1;vals)]
chk["col-sym"; qColRead[st1;mn1;`sym]; (1;syms)]
chk["col-txt"; qColRead[st1;mn1;`txt]; (1;txts)]
chk["col-badname"; qColRead[st1;mn1;`nope]; (0;"key")]
chk["col-badman"; qColRead[st1;5;`id]; (0;"shape")]
chk["man-bad"; qNames[5]; (0;"shape")]
chk["project"; qProject[tab1;`val`id]; (1;uw[oTable[`val`id;(vals;ids)]])]
chk["project-badname"; qProject[tab1;`val`nope]; (0;"key")]
chk["project-dup"; qProject[tab1;`id`id]; (0;"key")]
chk["fidx-gt"; qFilterIdx[ids;`gt;25]; (1;2 3 4)]
chk["fidx-le"; qFilterIdx[ids;`le;30]; (1;0 1 2)]
chk["fidx-eq"; qFilterIdx[ids;`eq;30]; (1;,2)]
chk["fidx-ne"; qFilterIdx[ids;`ne;30]; (1;0 1 3 4)]
chk["fidx-lt-none"; qFilterIdx[ids;`lt;10]; (1;!0)]
chk["fidx-ge"; qFilterIdx[ids;`ge;50]; (1;,4)]
chk["fidx-fgt"; qFilterIdx[vals;`gt;2.0]; (1;1 3 4)]
chk["fidx-fle"; qFilterIdx[vals;`le;1.5]; (1;0 2)]
chk["fidx-seq"; qFilterIdx[syms;`eq;`a]; (1;1 4)]
chk["fidx-sne"; qFilterIdx[syms;`ne;`b]; (1;1 3 4)]
chk["fidx-ceq"; qFilterIdx[txts;`eq;"c"]; (1;,2)]
chk["fidx-symlt"; qFilterIdx[syms;`lt;`b]; (0;"op")]
chk["fidx-badval"; qFilterIdx[ids;`eq;`a]; (0;"type")]
chk["fidx-charval"; qFilterIdx[txts;`eq;5]; (0;"type")]
chk["fidx-badop"; qFilterIdx[ids;`xx;30]; (0;"op")]
chk["filter"; qFilter[tab1;`id;`ge;30]; (1;uw[oTable[nms;(30 40 50;0.5 3.5 2.5;`b`c`a;"cde")]])]
chk["select"; qSelect[tab1;`val;`gt;2.0;`id`sym]; (1;uw[oTable[`id`sym;(20 40 50;`a`c`a)]])]
chk["agg-sum-i"; qAgg[tab1;`id;`sum]; (1;150)]
chk["agg-sum-f"; qAgg[tab1;`val;`sum]; (1;10.5)]
chk["agg-count"; qAgg[tab1;`txt;`count]; (1;5)]
chk["agg-min-i"; qAgg[tab1;`id;`min]; (1;10)]
chk["agg-max-f"; qAgg[tab1;`val;`max]; (1;3.5)]
chk["agg-min-c"; qAgg[tab1;`txt;`min]; (1;"a")]
chk["agg-max-c"; qAgg[tab1;`txt;`max]; (1;"e")]
chk["agg-min-sym"; qAgg[tab1;`sym;`min]; (0;"type")]
chk["agg-sym"; qAgg[tab1;`sym;`sum]; (0;"type")]
chk["agg-mean-f"; qAgg[tab1;`val;`mean]; (1;2.1)]
chk["agg-mean-i"; qAgg[tab1;`id;`mean]; (1;30.0)]
chk["agg-badop"; qAgg[tab1;`id;`xx]; (0;"op")]
chk["agg-badcol"; qAgg[tab1;`nope;`sum]; (0;"key")]
chk["scan"; qScan[st1;mn1;`val;`gt;2.0;`id`sym]; (1;uw[oTable[`id`sym;(20 40 50;`a`c`a)]])]
chk["scan-none"; qScan[st1;mn1;`id;`gt;100;(1#`id)]; (1;uw[oTable[(1#`id);(, !0)]])]
chk["scan-badproj"; qScan[st1;mn1;`id;`gt;25;(1#`nope)]; (0;"key")]
chk["scan-badpred"; qScan[st1;mn1;`nope;`gt;25;`id]; (0;"key")]
wr2:qWrite[st1;sp1[1]]
st2:wr2[1][0]
mn2:wr2[1][1]
chk["rewrite-addr"; mn2[3][0]; (,(0;4))]
chk["rewrite-read"; qRead[st2;mn2]; (1;tab1)]
big:!1000
tabB:uw[oTable[(1#`v);(,big)]]
spB:qSplitTable[tabB]
chk["big-chunks"; #spB[1][3][0]; 3]
cB0:uw[oColAt[uw[cDecode[spB[1][3][0][0]]];0]]
cB1:uw[oColAt[uw[cDecode[spB[1][3][0][1]]];0]]
cB2:uw[oColAt[uw[cDecode[spB[1][3][0][2]]];0]]
chk["big-c0n"; #cB0; 400]
chk["big-c0last"; cB0[399]; 399]
chk["big-c1first"; cB1[0]; 400]
chk["big-c2n"; #cB2; 200]
wrB:qWrite[sNew;spB[1]]
chk["big-read"; qRead[wrB[1][0];wrB[1][1]]; (1;tabB)]
chk["big-col"; qColRead[wrB[1][0];wrB[1][1];`v]; (1;big)]
tabF:uw[oTable[(1#`f);(,200#1.5)]]
spF:qSplitTable[tabF]
chk["flt-chunks"; #spF[1][3][0]; 2]
wrF:qWrite[sNew;spF[1]]
chk["flt-read"; qRead[wrF[1][0];wrF[1][1]]; (1;tabF)]
s128:128#"x"
sym128:`$s128
tabS:uw[oTable[(1#`s);(,25#sym128)]]
spS:qSplitTable[tabS]
chk["sym-chunks"; #spS[1][3][0]; 1]
wrS:qWrite[sNew;spS[1]]
chk["sym-read"; qRead[wrS[1][0];wrS[1][1]]; (1;tabS)]
tabS30:uw[oTable[(1#`s);(,30#sym128)]]
chk["sym30-chunks"; #qSplitTable[tabS30][1][3][0]; 2]
tabC:uw[oTable[(1#`c);(,3000#"ab")]]
spC:qSplitTable[tabC]
chk["char-chunks"; #spC[1][3][0]; 1]
wrC:qWrite[sNew;spC[1]]
chk["char-read"; qRead[wrC[1][0];wrC[1][1]]; (1;tabC)]
tabE:uw[oTable[nms;(!0;0#1.0 2.0;0#`a`b;"")]]
spE:qSplitTable[tabE]
chk["empty-chunks"; (#spE[1][3][0];#spE[1][3][1];#spE[1][3][2];#spE[1][3][3]); 0 0 0 0]
wrE:qWrite[sNew;spE[1]]
mnE:wrE[1][1]
chk["empty-rows"; qRows[mnE]; (1;0)]
chk["empty-read"; qRead[wrE[1][0];mnE]; (1;tabE)]
chk["empty-col-i"; qColRead[wrE[1][0];mnE;`id]; (1;!0)]
chk["empty-col-f"; qColRead[wrE[1][0];mnE;`val]; (1;0#1.0 2.0)]
chk["empty-col-s"; qColRead[wrE[1][0];mnE;`sym]; (1;0#`a`b)]
chk["empty-col-c"; qColRead[wrE[1][0];mnE;`txt]; (1;"")]
chk["empty-sum"; qAgg[tabE;`id;`sum]; (1;0)]
chk["empty-min"; qAgg[tabE;`id;`min]; (0;"empty")]
chk["empty-mean"; qAgg[tabE;`val;`mean]; (0;"empty")]
ge:{[x] x}'[!0]
tabG:(`table;(`a`b;(ge;ge)))
chk["genempty-valid"; oIsValid[tabG]; 1]
chk["genempty-type"; qSplitTable[tabG]; (0;"type")]
tabD:(`table;(`a`a;(1 2;3 4)))
chk["split-nontable"; qSplitTable[5]; (0;"type")]
chk["split-invalid"; qSplitTable[tabD]; (0;"valid")]
chk["write-nostore"; qWrite[5;sp1[1]]; (0;"type")]
stX:st1
pgX:stX[0]
pgX[100]:bMod[pgX[100]+1;256]
stX[0]:pgX
chk["write-corrupt"; qWrite[stX;sp1[1]]; (0;"valid")]
chk["read-badman"; qRead[st1;5]; (0;"shape")]
ads:mn1[3]
a0:ads[0]
a0[0]:(99;0)
ads[0]:a0
mnBad:(mn1[0];mn1[1];mn1[2];ads)
chk["read-badaddr"; qRead[st1;mnBad]; (0;"bounds")]
stC:st1
pgC:stC[0]
pgC[30]:bMod[pgC[30]+1;256]
stC[0]:pgC
chk["read-corrupt"; qColRead[stC;mn1;`id]; (0;"checksum")]
frId:sp1[1][3][0][0]
frVal:sp1[1][3][1][0]
stX0:(uw[sCreate[sNew]])[0]
pX0:uw[sPut[stX0;frId]]
stX1:pX0[0]
cX:uw[sCreate[stX1]]
stX2:cX[0]
stX3:uw[sAppendTo[stX2;1;frVal]]
aId:(,(0;0))
aVal:(,(1;0))
mnX:(`id`val;1 2;5;(aId;aVal))
chk["iso-man"; qIsManifest[mnX]; 1]
chk["iso-id"; qColRead[stX3;mnX;`id]; (1;ids)]
chk["iso-val"; qColRead[stX3;mnX;`val]; (1;vals)]
stI:stX3
pgI:stI[1]
pgI[30]:bMod[pgI[30]+1;256]
stI[1]:pgI
chk["iso-id-ok"; qColRead[stI;mnX;`id]; (1;ids)]
chk["iso-val-bad"; qColRead[stI;mnX;`val]; (0;"checksum")]
chk["iso-scan-ok"; qScan[stI;mnX;`id;`gt;25;(1#`id)]; (1;uw[oTable[(1#`id);(,30 40 50)]])]
chk["save-ok"; sSave[st1;"s6test"]; (1;"s6test")]
ld:sLoad["s6test"]
chk["load-ok"; ld[0]; 1]
chk["load-read"; qRead[ld[1];mn1]; (1;tab1)]
:[0=FC[0]; "ALL PASS"; "FAILURES"]
